{
  "_doc": "check_rules.py 讀取的專案設定。新增同步配對/錨點/allowlist 時登記於此，不改引擎（scripts/check_rules.py）。",

  "bare_references": {
    "globs": [".claude/commands/*.md", ".claude/rules/*.md"],
    "pattern": "CLAUDE\\.md",
    "exempt_files": [
      ".claude/rules/claude-md-edit.md"
    ],
    "_exempt_files_note": "claude-md-edit.md 全篇在示範/講解裸露 CLAUDE.md 規則本身，不適用此檢查。",
    "line_allowlist": [
      {"file": ".claude/commands/review-commands.md", "pattern": "commands / rules / CLAUDE\\.md"},
      {"file": ".claude/commands/review-commands.md", "pattern": "根目錄 `CLAUDE\\.md`"},
      {"file": ".claude/commands/wiki-lint.md", "pattern": "CLAUDE\\.md 健檢"},
      {"file": ".claude/commands/wiki-lint.md", "pattern": "根目錄 `CLAUDE\\.md`"},
      {"file": ".claude/commands/wiki-weekly-review.md", "pattern": "根目錄 `CLAUDE\\.md`"},
      {"file": ".claude/rules/wiki-ingest-people.md", "pattern": "CLAUDE\\.md 論述"}
    ]
  },

  "path_existence": {
    "globs": [".claude/commands/*.md", ".claude/rules/*.md"],
    "extensions": [".md", ".py", ".json", ".jsonl"],
    "allowlist_patterns": [
      "^news/YYYY-MM-DD\\.md$",
      "^news/TARGET_DATE\\.md$",
      "^news/YESTERDAY\\.md$",
      "^wiki/YYYY-MM-DD\\.md$",
      "^gathered_items\\.json$",
      "^emitted_items\\.json$",
      "^seen_urls\\.json$",
      "^src/gathered_items\\.json$",
      "^src/logs/pipeline_baseline\\.json$"
    ],
    "_allowlist_note": "以上為 placeholder 或執行期才產生的產物檔，不強制存在。",
    "bare_name_search_dirs": {
      "community-tech-tools.md": ["wiki/topics"],
      "community-tech-discussions.md": ["wiki/topics"],
      "community-pattern-trends.md": ["wiki/topics"],
      "community-tech-patterns.md": ["wiki/topics"]
    }
  },

  "anchors": [
    {"label": "首次出現 欄", "pattern": "\\| 首次出現 \\|", "file": "wiki/topics/community-tech-tools.md"},
    {"label": "痛點洞察 區塊", "pattern": "## 痛點洞察", "file": "wiki/topics/community-tech-tools.md"},
    {"label": "近期工具 欄", "pattern": "近期工具", "file": "wiki/topics/community-tech-tools.md"},
    {"label": "技術彙整 區塊", "pattern": "## 技術彙整", "file": "wiki/topics/community-tech-discussions.md"},
    {"label": "熱門討論 表格", "pattern": "熱門討論", "file": "wiki/topics/community-tech-discussions.md"},
    {"label": "衍生 欄", "pattern": "衍生", "file": "wiki/topics/community-tech-discussions.md"},
    {"label": "全覽表 區塊", "pattern": "全覽表", "file": "wiki/feature-radar.md"}
  ],

  "sync_pairs": [
    {
      "name": "news-pipeline.md <-> news-pipeline-steps.md：REPO_ROOT/PYTHON 逐字相同 + 不可背景",
      "assertion": "equal_values",
      "files": [".claude/commands/news-pipeline.md", ".claude/commands/news-pipeline-steps.md"],
      "pattern": "REPO_ROOT\\s*=\\s*(\\S+)"
    },
    {
      "name": "news-pipeline.md <-> news-pipeline-steps.md：PYTHON 逐字相同",
      "assertion": "equal_values",
      "files": [".claude/commands/news-pipeline.md", ".claude/commands/news-pipeline-steps.md"],
      "pattern": "PYTHON\\s*=\\s*(\\S+)"
    },
    {
      "name": "news-pipeline.md <-> news-pipeline-steps.md：皆明文「不可包進背景 agent」語意",
      "assertion": "all_contain",
      "files": [".claude/commands/news-pipeline.md", ".claude/commands/news-pipeline-steps.md"],
      "patterns": ["不可.*背景"]
    },
    {
      "name": "news-pipeline.md Phase B <-> wiki-ingest.md：互相參照，無精簡複本殘留",
      "assertion": "all_contain",
      "files": [".claude/commands/news-pipeline.md"],
      "patterns": ["wiki-ingest\\.md"]
    },
    {
      "name": "wiki-ingest.md 提及被 news-pipeline.md Phase B 呼叫，無精簡複本殘留",
      "assertion": "all_contain",
      "files": [".claude/commands/wiki-ingest.md"],
      "patterns": ["news-pipeline\\.md"]
    },
    {
      "name": "wiki-ingest.md 無「精簡複本」殘留字樣",
      "assertion": "min_count",
      "files": [".claude/commands/wiki-ingest.md"],
      "patterns": ["精簡複本"],
      "min": 0
    },
    {
      "name": "wiki-ingest.md / wiki-lint.md / rules/wiki-ingest.md：六類 subagent_type 名稱一致 + model: \"sonnet\"",
      "assertion": "all_contain",
      "files": [
        ".claude/commands/wiki-ingest.md",
        ".claude/commands/wiki-lint.md",
        ".claude/rules/wiki-ingest.md"
      ],
      "patterns": [
        "wiki-reporter-models",
        "wiki-reporter-features",
        "wiki-reporter-commercial",
        "wiki-reporter-safety-policy",
        "wiki-reporter-community",
        "wiki-reporter-people",
        "model: \"sonnet\""
      ]
    },
    {
      "name": "wiki-ingest-community.md <-> wiki-ingest-community-lint.md：lint-only 邊界（共用「每日 ingest 不」語意標記）",
      "assertion": "all_contain",
      "files": [".claude/rules/wiki-ingest-community.md", ".claude/rules/wiki-ingest-community-lint.md"],
      "patterns": ["每日 ingest 不"]
    },
    {
      "name": "wiki-ingest-community.md 明文 lint 專用",
      "assertion": "all_contain",
      "files": [".claude/rules/wiki-ingest-community.md"],
      "patterns": ["lint 專用"]
    },
    {
      "name": "wiki-ingest-community-lint.md 承接 tools 頁策展",
      "assertion": "all_contain",
      "files": [".claude/rules/wiki-ingest-community-lint.md"],
      "patterns": ["已脫離每日 ingest", "策展規則"]
    },
    {
      "name": "六份記者回報格式段皆含六欄（更新頁面/feature-radar 新增/index.md 狀態變更/新增頁面/同步自查/來源歸因）",
      "assertion": "all_contain",
      "files": [
        ".claude/rules/wiki-reporter-shared.md",
        ".claude/rules/wiki-ingest-models.md",
        ".claude/rules/wiki-ingest-features.md",
        ".claude/rules/wiki-ingest-commercial.md",
        ".claude/rules/wiki-ingest-safety-policy.md",
        ".claude/rules/wiki-ingest-community.md",
        ".claude/rules/wiki-ingest-people.md"
      ],
      "patterns": [
        "更新頁面：",
        "feature-radar 新增：",
        "index\\.md 狀態變更：",
        "新增頁面：",
        "同步自查：",
        "來源歸因："
      ]
    },
    {
      "name": "主編指南（rules/wiki-ingest.md）回報格式段同步六欄",
      "assertion": "all_contain",
      "files": [".claude/rules/wiki-ingest.md"],
      "patterns": [
        "更新頁面：",
        "feature-radar 新增：",
        "index\\.md 狀態變更：",
        "新增頁面：",
        "同步自查：",
        "來源歸因："
      ]
    },
    {
      "name": "wiki-ingest.md（command）關鍵步驟：feature-radar 彙整 + 呈現品質 log 欄位 + 完成前核對清單",
      "assertion": "all_contain",
      "files": [".claude/commands/wiki-ingest.md"],
      "patterns": [
        "wiki/feature-radar\\.md",
        "\\.claude/rules/wiki-ingest-features\\.md",
        "呈現品質",
        "完成前強制核對清單"
      ]
    },
    {
      "name": "wiki-lint.md 關鍵步驟：載入鏈 + 呈現品質標準引用 + 規則引用驗證 + 規則年齡審查",
      "assertion": "all_contain",
      "files": [".claude/commands/wiki-lint.md"],
      "patterns": [
        "wiki/CLAUDE\\.md",
        "\\.claude/rules/wiki-ingest\\.md",
        "Wiki 頁面呈現品質標準",
        "規則引用驗證",
        "規則年齡審查"
      ]
    },
    {
      "name": "news-pipeline.md 關鍵步驟：三段 Phase 齊全 + 已知結果 + 禁止背景包裹",
      "assertion": "all_contain",
      "files": [".claude/commands/news-pipeline.md"],
      "patterns": [
        "## Phase A",
        "## Phase B",
        "## Phase C",
        "已知結果",
        "本身也不可被包進背景 agent"
      ]
    },
    {
      "name": "news-pipeline-steps.md 關鍵步驟：Step 2 不在本檔 + Phase A/C 步驟劃分 + Step 6 log 寫入",
      "assertion": "all_contain",
      "files": [".claude/commands/news-pipeline-steps.md"],
      "patterns": [
        "Step 2.*不在本檔案",
        "# Phase A 步驟",
        "# Phase C 步驟",
        "Step 6：寫入 task_scheduler\\.log"
      ]
    }
  ],

  "coupling_hints": {
    "enabled": true,
    "globs": [".claude/commands/*.md", ".claude/rules/*.md"],
    "min_mutual_references": 2
  }
}
