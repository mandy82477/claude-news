{
  "_doc": "可共享的專案設定：hooks（Stop 擋規則檔未驗證與程式改動測試未綠、SessionStart 提醒未 commit、PostToolUse wiki lint、PreToolUse 擋 git add 全加變體／claude -p／破壞性 git 指令、依身分擋 news/ 寫入、閘與基線改動、子 agent 再委派、記者用 web 工具、派工缺 model／背景記者（guard_roles.py）、內容閘紅時擋 wiki commit 進 master（gate_wiki_commit.py）、擋掃到別 session 宣告中的路徑、大檔讀取觀測、雲端被動探針 probe_cloud_hooks.py——暫時，拿到證據即移除）。路徑用 $CLAUDE_PROJECT_DIR，任何 clone 都能跑。hook 指令一律先找 python 再退 python3（雲端 Linux 可能只有 python3；本機 python3 是 Store 假檔）。個人權限允許清單住 settings.local.json（已 gitignore）。",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "P=python; command -v python >/dev/null 2>&1 || P=python3; \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint_wiki_if_wiki.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "c=$(git status --porcelain 2>/dev/null | grep -vE 'gathered_items\\.json|emitted_items\\.json|seen_urls\\.json|\\.stackdump|settings\\.local\\.json|\\.obsidian/|\\.gitignore|\\.canvas|smart-connections' | grep -c . || true); [ \"${c:-0}\" -gt 0 ] && printf '{\"systemMessage\":\"⚠️ %s 個未 commit 的實質改動（code/規則/wiki）待收尾——git status 查看\"}' \"$c\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "P=python; command -v python >/dev/null 2>&1 || P=python3; \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_rules_on_stop.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "P=python; command -v python >/dev/null 2>&1 || P=python3; \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_tests_on_stop.py\"",
            "timeout": 180
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "P=python; command -v python >/dev/null 2>&1 || P=python3; \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/probe_cloud_hooks.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "P=python; command -v python >/dev/null 2>&1 || P=python3; \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_git_add_all.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "P=python; command -v python >/dev/null 2>&1 || P=python3; \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_claude_print.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "P=python; command -v python >/dev/null 2>&1 || P=python3; \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_destructive_git.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "P=python; command -v python >/dev/null 2>&1 || P=python3; \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_foreign_stage.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "P=python; command -v python >/dev/null 2>&1 || P=python3; \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_roles.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "P=python; command -v python >/dev/null 2>&1 || P=python3; \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate_wiki_commit.py\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "P=python; command -v python >/dev/null 2>&1 || P=python3; \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/observe_large_reads.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "P=python; command -v python >/dev/null 2>&1 || P=python3; \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_roles.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "P=python; command -v python >/dev/null 2>&1 || P=python3; \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_roles.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "P=python; command -v python >/dev/null 2>&1 || P=python3; \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_roles.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
