# Claude News Aggregator — 環境變數範例
# 複製為 .env 並填入實際值（.env 已在 .gitignore，不會被提交）
# 全部留空時，pipeline 仍可正常運作（GitHub 用未認證額度、Reddit 走 RSS 路徑）

# GitHub Personal Access Token（無需任何權限的 classic PAT 即可）
# 用途：將 GitHub API 額度從 60 次/小時 提升到 5000 次/小時
# 申請：https://github.com/settings/tokens → Generate new token (classic) → 不勾選任何 scope
GITHUB_TOKEN=

# Reddit API OAuth（script app）
# 用途：改走 OAuth API（取得 ups 分數），未設定時自動退回現行 RSS 路徑
# 申請：https://www.reddit.com/prefs/apps → create app → 選 "script"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
